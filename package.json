{
  "name": "forgeyard",
  "version": "0.1.0",
  "description": "A project-scoped factory for trustworthy agentic development workflows.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "forgeyard": "dist/cli/main.js"
  },
  "files": [
    "dist/",
    "schemas/",
    "profiles/",
    "packs/",
    "sources/",
    "docs/guides/catalog-and-context.md",
    "docs/guides/delivery-workflow.md",
    "docs/guides/harnesses.md",
    "docs/guides/native-factory.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "SBOM.spdx.json"
  ],
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration tests/adversarial tests/golden",
    "test:roundtrip": "npm run build && vitest run tests/roundtrip",
    "catalog:check": "tsx scripts/vendor-catalog.ts --check",
    "verify": "npm run typecheck && npm test && npm run build && npm run catalog:check && npm run provenance:check && npm run audit:release && npm run pack:check",
    "provenance:generate": "tsx scripts/generate-provenance.ts --write",
    "provenance:check": "tsx scripts/generate-provenance.ts --check",
    "audit:release": "tsx scripts/release-audit.ts",
    "audit:dependencies": "npm audit --audit-level=low",
    "pack:check": "npm pack --dry-run --json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "15.0.0",
    "execa": "10.0.1",
    "smol-toml": "1.8.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
