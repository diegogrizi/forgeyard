{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forgeyard.dev/schemas/pack.schema.json",
  "title": "Forgeyard pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "license", "provenance", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "license": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": [
            "original",
            "dependency",
            "vendored-unmodified",
            "adapted",
            "generated-from-spec",
            "clean-room-reimplementation",
            "reference-only"
          ]
        },
        "sourceId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,127}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "not": { "const": "original" } } } },
          "then": {
            "required": ["sourceId"],
            "properties": {
              "sourceId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,127}$" }
            }
          }
        }
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "entry",
          "slot",
          "template",
          "ownership",
          "requires",
          "conflicts"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" },
          "kind": {
            "enum": [
              "instruction",
              "skill",
              "agent",
              "command",
              "workflow",
              "hook",
              "connector",
              "tool-policy",
              "template",
              "validator",
              "reference",
              "catalog"
            ]
          },
          "entry": { "type": "string", "minLength": 1, "maxLength": 260 },
          "entryType": { "enum": ["file", "tree"] },
          "format": { "enum": ["portable-plugin-marketplace-v1"] },
          "slot": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" },
          "template": { "type": "boolean" },
          "ownership": { "enum": ["managed", "seed"] },
          "requires": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" }
          },
          "conflicts": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "kind": { "const": "catalog" } },
              "required": ["kind"]
            },
            "then": {
              "required": ["entryType", "format"],
              "properties": {
                "entryType": { "const": "tree" },
                "format": { "const": "portable-plugin-marketplace-v1" }
              }
            }
          },
          {
            "if": {
              "properties": { "entryType": { "const": "tree" } },
              "required": ["entryType"]
            },
            "then": {
              "required": ["format"],
              "properties": {
                "kind": { "const": "catalog" },
                "format": { "const": "portable-plugin-marketplace-v1" }
              }
            }
          }
        ]
      }
    }
  }
}
