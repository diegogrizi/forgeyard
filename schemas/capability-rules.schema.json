{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forgeyard.dev/schemas/capability-rules.schema.json",
  "title": "Forgeyard automatic capability rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseline", "rules", "exclusions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseline": { "$ref": "#/definitions/choices" },
    "rules": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "when", "include"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "kinds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["frontend", "backend", "full-stack", "mobile", "data", "infrastructure", "library", "cli", "unknown"] }
              },
              "languages": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 80 }
              },
              "frameworks": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 120 }
              },
              "requestPatterns": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 200 }
              }
            }
          },
          "include": { "$ref": "#/definitions/choices" }
        }
      }
    },
    "exclusions": { "$ref": "#/definitions/choices" }
  },
  "definitions": {
    "choices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  }
}
