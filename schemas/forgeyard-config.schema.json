{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forgeyard.dev/schemas/forgeyard-config.schema.json",
  "title": "Forgeyard configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "harnesses",
    "profile",
    "timeboxMinutes",
    "quality",
    "paths",
    "orchestration",
    "presentation"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purpose", "mode"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
        "mode": { "enum": ["new", "existing"] }
      }
    },
    "harnesses": {
      "type": "array",
      "const": ["codex"]
    },
    "profile": { "const": "hackathon" },
    "timeboxMinutes": { "type": "integer", "minimum": 30, "maximum": 1440 },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "argv"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 80 },
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
              }
            }
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutableRoots", "protectedPaths", "presentation"],
      "properties": {
        "mutableRoots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 260 }
        },
        "protectedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 260 }
        },
        "presentation": { "type": "string", "minLength": 1, "maxLength": 260 }
      }
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "maxConcurrency"],
      "properties": {
        "mode": { "enum": ["native", "guided"] },
        "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "audience", "durationMinutes", "offline"],
      "properties": {
        "enabled": { "const": true },
        "audience": { "type": "string", "minLength": 1, "maxLength": 200 },
        "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 60 },
        "offline": { "const": true }
      }
    }
  }
}
