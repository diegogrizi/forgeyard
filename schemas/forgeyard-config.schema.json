{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forgeyard.dev/schemas/forgeyard-config.schema.json",
  "title": "Forgeyard configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "harnesses",
    "profile",
    "catalog",
    "timeboxMinutes",
    "quality",
    "paths",
    "orchestration",
    "presentation",
    "intake",
    "composition",
    "autonomy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purpose", "mode"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
        "mode": { "enum": ["new", "existing"] }
      }
    },
    "harnesses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["codex", "claude-code", "cursor"] }
    },
    "profile": { "enum": ["minimal", "hackathon", "full", "tailored"] },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection", "plugins"],
      "properties": {
        "selection": { "enum": ["none", "curated", "all"] },
        "plugins": {
          "type": "array",
          "maxItems": 92,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "selection": { "enum": ["none", "all"] } }, "required": ["selection"] },
          "then": { "properties": { "plugins": { "type": "array", "maxItems": 0 } } }
        }
      ]
    },
    "timeboxMinutes": { "type": "integer", "minimum": 30, "maximum": 1440 },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "argv"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 80 },
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
              }
            }
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutableRoots", "protectedPaths", "presentation"],
      "properties": {
        "mutableRoots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 260 }
        },
        "protectedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 260 }
        },
        "presentation": { "type": "string", "minLength": 1, "maxLength": 260 }
      }
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "maxConcurrency"],
      "properties": {
        "mode": { "enum": ["native", "guided"] },
        "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "audience", "durationMinutes", "offline"],
      "properties": {
        "enabled": { "type": "boolean" },
        "audience": { "type": "string", "minLength": 1, "maxLength": 200 },
        "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 60 },
        "offline": { "const": true }
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "request", "sources", "kind", "languages", "frameworks", "evidence", "confidence", "questions"],
      "properties": {
        "strategy": { "enum": ["automatic", "manual"] },
        "request": { "type": "string", "maxLength": 20000 },
        "sources": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 260 }
        },
        "kind": { "enum": ["frontend", "backend", "full-stack", "mobile", "data", "infrastructure", "library", "cli", "unknown"] },
        "languages": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "frameworks": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "evidence": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "signal"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 260 },
              "signal": { "type": "string", "minLength": 1, "maxLength": 300 }
            }
          }
        },
        "confidence": { "enum": ["high", "medium", "low"] },
        "questions": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "packs", "selected", "excluded", "analysisSha256"],
      "properties": {
        "strategy": { "enum": ["automatic", "manual"] },
        "packs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" }
        },
        "selected": { "$ref": "#/definitions/compositionChoices" },
        "excluded": { "$ref": "#/definitions/compositionChoices" },
        "analysisSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "stopOnAmbiguity", "externalEffects"],
      "properties": {
        "level": { "enum": ["supervised", "balanced", "autonomous"] },
        "maxCostUsd": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
        "stopOnAmbiguity": { "const": true },
        "externalEffects": { "const": "ask" }
      }
    }
  },
  "definitions": {
    "compositionChoices": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "profile": { "const": "minimal" } }, "required": ["profile"] },
      "then": {
        "properties": {
          "catalog": { "type": "object", "properties": { "selection": { "const": "none" } } },
          "presentation": { "type": "object", "properties": { "enabled": { "const": false } } }
        }
      }
    },
    {
      "if": { "properties": { "profile": { "const": "full" } }, "required": ["profile"] },
      "then": { "properties": { "catalog": { "type": "object", "properties": { "selection": { "const": "all" } } } } }
    },
    {
      "if": { "properties": { "profile": { "const": "hackathon" } }, "required": ["profile"] },
      "then": { "properties": { "catalog": { "type": "object", "properties": { "selection": { "enum": ["curated", "all"] } } } } }
    },
    {
      "if": { "properties": { "profile": { "const": "tailored" } }, "required": ["profile"] },
      "then": {
        "properties": {
          "catalog": { "type": "object", "properties": { "selection": { "const": "curated" } } },
          "composition": { "type": "object", "properties": { "strategy": { "const": "automatic" } } }
        }
      }
    }
  ]
}
