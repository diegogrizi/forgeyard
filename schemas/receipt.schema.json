{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forgeyard.dev/schemas/receipt.schema.json",
  "title": "Forgeyard verification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "taskId",
    "taskSha256",
    "argvSha256",
    "gitCommit",
    "startedAt",
    "finishedAt",
    "durationMs",
    "exitCode",
    "stdoutSha256",
    "stderrSha256",
    "status"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "receiptId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$" },
    "taskId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,31}$" },
    "taskSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "argvSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "integer", "minimum": 0 },
    "exitCode": { "type": "integer", "minimum": 0 },
    "stdoutSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stderrSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["passed", "failed"] }
  }
}
