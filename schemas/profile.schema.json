{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forgeyard.dev/schemas/profile.schema.json",
  "title": "Forgeyard profile manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "packs", "catalog", "defaults"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "enum": ["minimal", "hackathon", "full"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "packs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection", "plugins"],
      "properties": {
        "selection": { "enum": ["none", "curated", "all"] },
        "plugins": {
          "type": "array",
          "maxItems": 92,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "selection": { "enum": ["none", "all"] } }, "required": ["selection"] },
          "then": { "properties": { "plugins": { "type": "array", "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "selection": { "const": "curated" } }, "required": ["selection"] },
          "then": { "properties": { "plugins": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeboxMinutes", "orchestration", "presentation"],
      "properties": {
        "timeboxMinutes": { "type": "integer", "minimum": 30, "maximum": 1440 },
        "orchestration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "maxConcurrency"],
          "properties": {
            "mode": { "enum": ["native", "guided"] },
            "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 16 }
          }
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "audience", "durationMinutes", "offline"],
          "properties": {
            "enabled": { "type": "boolean" },
            "audience": { "type": "string", "minLength": 1, "maxLength": 200 },
            "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 60 },
            "offline": { "const": true }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "id": { "const": "minimal" } }, "required": ["id"] },
      "then": {
        "properties": {
          "catalog": { "type": "object", "properties": { "selection": { "const": "none" } } },
          "defaults": {
            "type": "object",
            "properties": {
              "presentation": { "type": "object", "properties": { "enabled": { "const": false } } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "id": { "const": "hackathon" } }, "required": ["id"] },
      "then": { "properties": { "catalog": { "type": "object", "properties": { "selection": { "const": "curated" } } } } }
    },
    {
      "if": { "properties": { "id": { "const": "full" } }, "required": ["id"] },
      "then": { "properties": { "catalog": { "type": "object", "properties": { "selection": { "const": "all" } } } } }
    }
  ]
}
